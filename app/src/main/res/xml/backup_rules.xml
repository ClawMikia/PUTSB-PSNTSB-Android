<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!--
        Debt records are the user's real data, so they are backed up.
        The gamification campaign is deliberately NOT included: excluding
        gamification_db is what makes every achievement, quest, NPC, coin and
        XP point return to zero when the app is uninstalled.
    -->
    <include domain="database" path="debt_tracker_db" />
    <include domain="sharedpref" path="." />
    <exclude domain="database" path="gamification_db" />
    <exclude domain="database" path="gamification_db-shm" />
    <exclude domain="database" path="gamification_db-wal" />
    <exclude domain="database" path="gamification_db-journal" />
</full-backup-content>
