<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!--
        Only real debt data leaves the device. gamification_db is excluded from
        both cloud backup and device transfer, so the campaign always starts
        from zero on a fresh install.
    -->
    <cloud-backup>
        <include domain="database" path="debt_tracker_db" />
        <exclude domain="database" path="gamification_db" />
        <exclude domain="database" path="gamification_db-shm" />
        <exclude domain="database" path="gamification_db-wal" />
        <exclude domain="database" path="gamification_db-journal" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="debt_tracker_db" />
        <exclude domain="database" path="gamification_db" />
        <exclude domain="database" path="gamification_db-shm" />
        <exclude domain="database" path="gamification_db-wal" />
        <exclude domain="database" path="gamification_db-journal" />
    </device-transfer>
</data-extraction-rules>
