# ── Gradle / build output ────────────────────────────────
# NOTE: patterns must be anchored with a leading slash where
# they only apply to the repo root.
.gradle/
**/build/
/build/
!gradle/wrapper/gradle-wrapper.jar

# Generated by the Android Gradle Plugin / KSP / Hilt
*.iml
.kotlin/
captures/
.externalNativeBuild/
.cxx/

# ── Local machine configuration ──────────────────────────
# Contains an absolute SDK path; never portable.
local.properties
local.defaults.properties

# ── Android Studio / IntelliJ ────────────────────────────
.idea/
*.iws
*.ipr
.factorypath

# AI refactoring assistant scratch state (machine local)
.refact/

# ── Keystores & signing material ─────────────────────────
# NEVER commit these. Generate your own via keytool.
*.jks
*.keystore
*.p12
*.pfx
release/
debug/
signing/

# ── Secrets & service config ─────────────────────────────
google-services.json
secrets.properties
keystore.properties

# ── Generated Room schema exports ────────────────────────
# Kept out of the repo: schemas are reproducible from the
# entity definitions and only bloat the history.
**/schemas/

# ── Unit test / instrumentation output ──────────────────
**/test-results/
**/reports/
tests/
coverage/
*.coverage

